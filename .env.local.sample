# Copy to .env.local (gitignored, never deployed), or let ./configure.sh write it. Local-only overrides of .env,
# plus the API's secrets. On Vercel, set the server values as project environment variables instead.

# --- EscapeVelocity backends this app calls (local only) ---
# One line per folder under src/Backends/<Name>, named VITE_BACKEND_<NAME uppercased>_URL, with no trailing slash.
# A backend left unset hides every segment that requires it, which is what happens on Vercel.
# Each backend must also list this app's origin (http://localhost:7400) in ALLOWED_FRONTEND_URLS in its BackEnd/.env.
# VITE_BACKEND_ESCAPEVELOCITY_URL=http://localhost:18100
# VITE_BACKEND_TOOLS_URL=http://localhost:18700

# --- The app's own API (server/, when features.api is on) ---
# API_PORT=7410

# Google sign-in (features.auth = "google"). The client id itself is public and lives in vanillabean.config.json.
# GOOGLE_CLIENT_SECRET=
# JWT_SECRET_KEY=
# ALLOWED_EMAILS=you@example.com

# MongoDB (features.database = "mongodb") - local mongod in dev, Atlas on Vercel.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=vanillabean
