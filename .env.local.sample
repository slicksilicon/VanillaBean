# Copy to .env.local (gitignored, never deployed). Local-only overrides of .env.
#
# EscapeVelocity backends this app calls - one line per folder under src/Backends/<Name>,
# named VITE_BACKEND_<NAME uppercased>_URL, with no trailing slash.
# A backend left unset hides every segment that requires it, which is what happens on Vercel.
# Each backend must also list this app's origin (http://localhost:7400) in ALLOWED_FRONTEND_URLS in its BackEnd/.env.
VITE_BACKEND_ESCAPEVELOCITY_URL=http://localhost:18100
# VITE_BACKEND_TOOLS_URL=http://localhost:18700
